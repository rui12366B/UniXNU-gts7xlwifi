diff --git a/scripts/unixnu/devicetree.py b/scripts/unixnu/devicetree.py
index 3027603..d725021 100644
--- a/scripts/unixnu/devicetree.py
+++ b/scripts/unixnu/devicetree.py
@@ -395,6 +395,10 @@ def generate(dtb, config, *, unique_chip_id=None, data=False, trust=False, addon
             if kind not in (['E'], ['P']):
                 raise Error(f'{entry.name}: unixnu,cluster-type must be "E" or "P"')
             properties.append(('cluster-type', struct.pack('<I', ord(kind[0]))))
