diff --git a/patches/mesa/turnip-darwin-bo-retire-safe.patch b/patches/mesa/turnip-darwin-bo-retire-safe.patch
new file mode 100644
index 0000000..27ff6d4
--- /dev/null
+++ b/patches/mesa/turnip-darwin-bo-retire-safe.patch
@@ -0,0 +1,218 @@
+diff --git a/src/freedreno/vulkan/tu_knl_darwin.cc b/src/freedreno/vulkan/tu_knl_darwin.cc
+index f5de114..b9917d1 100644
+--- a/src/freedreno/vulkan/tu_knl_darwin.cc
++++ b/src/freedreno/vulkan/tu_knl_darwin.cc
+@@ -11,6 +11,7 @@
+ #include <stdlib.h>
+ #include <string.h>
+ #include <sys/mman.h>
++#include <sys/sysctl.h>
+ #include <unistd.h>
+ 
+ #include <IOKit/IOKitLib.h>
+@@ -56,8 +57,81 @@ static struct {
+    uint32_t last_fence;
+    NativeAdrenoAbiDeviceInfo info;
+    NativeAdrenoAbiParams params;
++   /* t970-bo-safe (darwin_bo_safe_mode): the newest fence any submission of this process got (last_fence is the one noted last,
++    * which two queues can make go backwards), and the submissions in progress, each by the sequence number it entered with
++    * (0 = a free slot). */
++   uint32_t max_fence;
++   uint64_t submit_entered;
++   uint64_t submit_active[32];
+ } dw = { .lock = PTHREAD_MUTEX_INITIALIZER };
+ 
++/* t970-bo-safe=<n> on the boot line (kern.bootargs, read once): how a freed BO's lease ends.
++ *   0  as before: the BO is stamped with last_fence when it is freed and reused (cache) or released once that fence completed.
++ *   1  (default) the stamp covers every submission in progress when the BO was freed. One still being built or waiting for its
++ *      semaphores when the free happened (darwin_queue_submit releases submit_mutex in its wait-before-signal) has no fence yet:
++ *      the record waits until each such submission has left darwin_queue_submit, then takes the newest fence (max_fence) and waits
++ *      for that. The SM-T970 showed the GPU executing zeroed or stale command memory (combo10: CP read 0x1_1d4c16e0, IB1 words 0,
++ *      CP_HW_ERROR storm; int5: an IB2 pointer below the client window) and a kernel refusal of a submission naming a freed BO
++ *      (combo8b), which is what a BO reused or released under a submission that was not stamped would do.
++ *   2  as 1, and no freed BO enters the BO cache (every one is released): the cache's reuse taken out of the picture. */
++static unsigned
++darwin_bo_safe_mode(void)
++{
++   static int mode = -1;
++   if (mode < 0) {
++      unsigned value = 1;
++      char args[1024] = {};
++      size_t size = sizeof(args) - 1;
++      if (sysctlbyname("kern.bootargs", args, &size, NULL, 0) == 0) {
++         const char *at = strstr(args, "t970-bo-safe=");
++         if (at)
++            value = (unsigned)strtoul(at + strlen("t970-bo-safe="), NULL, 10);
++      }
++      mode = value > 2 ? 1 : (int)value;
++   }
++   return (unsigned)mode;
++}
++
++/* Called under dw.lock: the oldest submission still inside darwin_queue_submit, UINT64_MAX when none is. */
++static uint64_t
++darwin_oldest_active_submit(void)
++{
++   uint64_t oldest = UINT64_MAX;
++   for (unsigned i = 0; i < ARRAY_SIZE(dw.submit_active); ++i)
++      if (dw.submit_active[i] && dw.submit_active[i] < oldest)
++         oldest = dw.submit_active[i];
++   return oldest;
++}
++
++/* One submission's stay in darwin_queue_submit, for the t970-bo-safe stamps. More submissions at once than slots (none seen: the
++ * device's submit_mutex serializes all but the semaphore waits) are counted as one that never ends until a slot frees, so a BO
++ * freed meanwhile waits rather than being stamped short. */
++struct darwin_submit_scope {
++   unsigned slot = UINT32_MAX;
++   darwin_submit_scope()
++   {
++      pthread_mutex_lock(&dw.lock);
++      const uint64_t sequence = ++dw.submit_entered;
++      for (unsigned i = 0; i < ARRAY_SIZE(dw.submit_active); ++i)
++         if (!dw.submit_active[i]) {
++            dw.submit_active[i] = sequence;
++            slot = i;
++            break;
++         }
++      pthread_mutex_unlock(&dw.lock);
++   }
++   ~darwin_submit_scope()
++   {
++      if (slot == UINT32_MAX)
++         return;
++      pthread_mutex_lock(&dw.lock);
++      dw.submit_active[slot] = 0;
++      pthread_mutex_unlock(&dw.lock);
++   }
++   darwin_submit_scope(const darwin_submit_scope &) = delete;
++   darwin_submit_scope &operator=(const darwin_submit_scope &) = delete;
++};
++
+ /* Preserve the native handle, CPU view and IOVA until the captured ring fence
+  * actually completed. An unrelated later submission never extends this lease.
+  * The queue grows with what is waiting; destruction never waits. */
+@@ -66,6 +140,9 @@ struct darwin_retired_bo {
+    void *mapping;
+    uint32_t token, fence;
+    bool cacheable, read_only;
++   /* t970-bo-safe: nonzero while the stamp waits for the submissions in progress at the free, which entered at or before this
++    * sequence number; fence is then taken from max_fence once they all left. */
++   uint64_t entered;
+ };
+ 
+ /* A freed BO whose fence completed stays whole (kernel handle, GPU mapping, CPU lease) in a size-class cache and is handed to the next
+@@ -749,7 +826,18 @@ darwin_reap_locked(struct tu_device *dev, struct darwin_retire_state *retire)
+    for (unsigned i = 0; i < total; ++i) {
+       struct darwin_retired_bo *bo = &retire->entries[(retire->head + i) % retire->capacity];
+       bool ready = true;
+-      if (bo->fence) {
++      if (bo->entered) {
++         /* t970-bo-safe: every submission in progress at the free has left darwin_queue_submit; the newest fence covers them all. */
++         pthread_mutex_lock(&dw.lock);
++         if (darwin_oldest_active_submit() > bo->entered) {
++            bo->fence = dw.max_fence;
++            bo->entered = 0;
++         }
++         pthread_mutex_unlock(&dw.lock);
++         if (bo->entered)
++            ready = false;
++      }
++      if (ready && bo->fence) {
+          if (have_pending_fence && bo->fence == pending_fence) {
+             ready = false;
+          } else if (!have_completed_fence || bo->fence != completed_fence) {
+@@ -1127,12 +1215,15 @@ darwin_bo_finish(struct tu_device *dev, struct tu_bo *bo)
+       }
+    }
+    if (retire->count < retire->capacity) {
++      const unsigned safe = darwin_bo_safe_mode();
+       pthread_mutex_lock(&dw.lock);
+-      uint32_t fence = dw.last_fence;
++      uint32_t fence = safe ? dw.max_fence : dw.last_fence;
++      /* t970-bo-safe: a submission still inside darwin_queue_submit may name this BO and has no fence yet. */
++      const uint64_t entered = safe && darwin_oldest_active_submit() != UINT64_MAX ? dw.submit_entered : 0;
+       pthread_mutex_unlock(&dw.lock);
+       unsigned slot = (retire->head + retire->count) % retire->capacity;
+       retire->entries[slot] = {bo->darwin_handle, bo->iova, bo->darwin_alloc_size ? bo->darwin_alloc_size : bo->size, bo->map,
+-                               bo->darwin_token, fence, bo->darwin_alloc_size != 0, bo->darwin_read_only};
++                               bo->darwin_token, fence, bo->darwin_alloc_size != 0 && safe < 2, bo->darwin_read_only, entered};
+       ++retire->count;
+       ++retire->enqueued;
+       darwin_reap_locked(dev, retire);
+@@ -1153,8 +1244,19 @@ darwin_bo_finish(struct tu_device *dev, struct tu_bo *bo)
+ 
+ struct tu_darwin_queue_submit {
+    struct util_dynarray commands; /* NativeAdrenoAbiSubmitBuffer */
++   /* t970-bo-safe: entries whose BO was already freed when the submission was built (darwin_bo_finish zeroes the struct), and the
++    * first such BO's kernel handle. */
++   unsigned stale;
++   uint64_t stale_handle;
+ };
+ 
++/* t970-bo-safe: a submission naming a freed BO is not sent (darwin_queue_submit). Its kernel refusal (an unknown handle,
++ * kIOReturnBadArgument) lost the device, and the render server ended itself (SM-T970 combo13c: Settings opened and closed fast,
++ * "sf 1 e00002c2:5 p55"). The kernel counts these drops through a note of this kind: words {stale entries, handle lo, handle hi,
++ * all entries}. */
++enum { DARWIN_NOTE_STALE_SUBMIT = 0x5354 };
++static uint32_t darwin_stale_submits;
++
+ static void *
+ darwin_submit_create(struct tu_device *device)
+ {
+@@ -1178,6 +1280,11 @@ darwin_submit_add_entries(struct tu_device *device, void *_submit,
+    NativeAdrenoAbiSubmitBuffer *cmds = (NativeAdrenoAbiSubmitBuffer *)
+       util_dynarray_grow(&submit->commands, NativeAdrenoAbiSubmitBuffer, num_entries);
+    for (unsigned i = 0; i < num_entries; i++) {
++      const struct tu_bo *bo = entries[i].bo;
++      if (!bo || !bo->darwin_handle || p_atomic_read(&((struct tu_bo *)bo)->refcnt) <= 0) {
++         if (!submit->stale++)
++            submit->stale_handle = bo ? bo->darwin_handle : 0;
++      }
+       cmds[i] = (NativeAdrenoAbiSubmitBuffer) {
+          .handle = entries[i].bo->darwin_handle,
+          .iova = entries[i].bo->iova + entries[i].offset,
+@@ -1362,6 +1469,9 @@ darwin_note_fence(uint32_t fence)
+    }
+    dw.inflight[dw.inflight_count++] = fence;
+    dw.last_fence = fence;
++   /* Fences are 32-bit and wrap: newer is a positive difference. */
++   if (!dw.max_fence || (int32_t)(fence - dw.max_fence) > 0)
++      dw.max_fence = fence;
+ }
+ 
+ #ifdef __APPLE__
+@@ -1466,6 +1576,8 @@ darwin_queue_submit(struct tu_queue *queue, void *_submit,
+ {
+    struct tu_darwin_queue_submit *submit = (struct tu_darwin_queue_submit *)_submit;
+    struct tu_device *dev = queue->device;
++   /* t970-bo-safe: from here until the fence is noted, a BO this submission names is not stamped short (darwin_bo_finish). */
++   darwin_submit_scope scope;
+ 
+    /* Syncs belong to this client, whose Vulkan queues all use kernel queue 0.
+     * That queue stays on one ring until its outstanding prefix completes, including
+@@ -1483,7 +1595,23 @@ darwin_queue_submit(struct tu_queue *queue, void *_submit,
+    rec.sync_wait_us = (uint32_t)((tu_trace_clock_ns() - rec.ns) / 1000);
+ 
+    uint32_t fence = 0;
+-   const unsigned total = util_dynarray_num_elements(&submit->commands, NativeAdrenoAbiSubmitBuffer);
++   unsigned total = util_dynarray_num_elements(&submit->commands, NativeAdrenoAbiSubmitBuffer);
++   if (submit->stale && darwin_bo_safe_mode()) {
++      /* t970-bo-safe: not sent. The signals resolve with the last earlier submission, as for an empty one; what it would have drawn is
++       * lost, which beats the lost device the kernel's refusal made of it. */
++      p_atomic_inc(&darwin_stale_submits);
++      NativeAdrenoAbiNote note = {};
++      note.kind = DARWIN_NOTE_STALE_SUBMIT;
++      note.count = 4;
++      note.words[0] = submit->stale;
++      note.words[1] = (uint32_t)submit->stale_handle;
++      note.words[2] = (uint32_t)(submit->stale_handle >> 32);
++      note.words[3] = total;
++      (void)dw_call(NativeAdrenoMethodNote, &note, sizeof(note), NULL, 0);
++      mesa_loge("darwin: submission with %u freed BO(s) (first handle %#llx) of %u entries not sent", submit->stale,
++                (unsigned long long)submit->stale_handle, total);
++      total = 0;
++   }
+    if (total) {
+       const NativeAdrenoAbiSubmitBuffer *all =
+          util_dynarray_element(&submit->commands, NativeAdrenoAbiSubmitBuffer, 0);
