From b2e34713b2d77db4393eade0bbb2cadb002b10ba Mon Sep 17 00:00:00 2001
From: t970 <morninglane27@gmail.com>
Date: Thu, 5 Nov 2026 09:47:20 +0000
Subject: [PATCH 6/7] gts7xlwifi: XR10 probe round 2 (render into private 550,
 fragment-stage sampling)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 NativeAdrenoMetalPlugin.mm | 91 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 91 insertions(+)

diff --git a/NativeAdrenoMetalPlugin.mm b/NativeAdrenoMetalPlugin.mm
index 2297bb4..52d22b7 100644
--- a/NativeAdrenoMetalPlugin.mm
+++ b/NativeAdrenoMetalPlugin.mm
@@ -86,6 +86,97 @@ static void t970Xr10Probe(Gpu &gpu, id<MTLDevice> device) {
                  k(2), k(6), k(10), k(14));
         t970Row(gpu, 47 - pass * 2, text);
     }
+    // Round 2. Y (row 46): gradient_fs renders into a PRIVATE 550 target (render target usage too), xr10_probe reads it back.
+    // Z (row 44): sample_fs samples a shared, CPU-filled 550 texture in the FRAGMENT stage into an RGBA32Float target read by getBytes.
+    id<MTLFunction> vs = [library newFunctionWithName:@"fullscreen_vs"], gradient = [library newFunctionWithName:@"gradient_fs"],
+                    sampleFs = [library newFunctionWithName:@"sample_fs"];
+    if (!vs || !gradient || !sampleFs) {t970Row(gpu, 46, "Y no round-2 functions"); return;}
+    Class descriptorClass = NSClassFromString(@"MTLTextureDescriptor"), pipelineClass = NSClassFromString(@"MTLRenderPipelineDescriptor"),
+          passClass = NSClassFromString(@"MTLRenderPassDescriptor");
+    auto renderPipeline = [&](id<MTLFunction> fragment, MTLPixelFormat format) -> id<MTLRenderPipelineState> {
+        MTLRenderPipelineDescriptor *rp = [[pipelineClass alloc] init];
+        rp.vertexFunction = vs;
+        rp.fragmentFunction = fragment;
+        rp.colorAttachments[0].pixelFormat = format;
+        NSError *e = nil;
+        return [device newRenderPipelineStateWithDescriptor:rp error:&e];
+    };
+    auto draw = [&](id<MTLRenderPipelineState> state, id<MTLTexture> target, id<MTLTexture> input) -> long {
+        MTLRenderPassDescriptor *pass = [passClass renderPassDescriptor];
+        pass.colorAttachments[0].texture = target;
+        pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+        pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+        pass.colorAttachments[0].clearColor = MTLClearColorMake(0, 0, 0, 1);
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        id<MTLCommandBuffer> commands = [queue commandBuffer];
+        id<MTLRenderCommandEncoder> encoder = [commands renderCommandEncoderWithDescriptor:pass];
+        [encoder setRenderPipelineState:state];
+        if (input) [encoder setFragmentTexture:input atIndex:0];
+        [encoder drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+        [encoder endEncoding];
+        [commands commit];
+        [commands waitUntilCompleted];
+        return commands.error ? (long)commands.error.code : 0;
+    };
+    auto computeRead = [&](id<MTLTexture> texture, float *v) -> long {
+        id<MTLBuffer> out = [device newBufferWithLength:16 * sizeof(float) options:MTLResourceStorageModeShared];
+        memset(out.contents, 0xff, 16 * sizeof(float));
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        id<MTLCommandBuffer> commands = [queue commandBuffer];
+        id<MTLComputeCommandEncoder> encoder = [commands computeCommandEncoder];
+        [encoder setComputePipelineState:pipeline];
+        [encoder setTexture:texture atIndex:0];
+        [encoder setBuffer:out offset:0 atIndex:0];
+        [encoder dispatchThreads:MTLSizeMake(4, 1, 1) threadsPerThreadgroup:MTLSizeMake(4, 1, 1)];
+        [encoder endEncoding];
+        [commands commit];
+        [commands waitUntilCompleted];
+        memcpy(v, out.contents, 16 * sizeof(float));
+        return commands.error ? (long)commands.error.code : 0;
+    };
+    auto k = [](float f) {return (int)lrintf(f * 1000.0f);};
+    {
+        MTLTextureDescriptor *d = [(id)descriptorClass texture2DDescriptorWithPixelFormat:(MTLPixelFormat)550 width:width height:height mipmapped:NO];
+        d.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+        d.storageMode = MTLStorageModePrivate;
+        id<MTLTexture> target = [device newTextureWithDescriptor:d];
+        id<MTLRenderPipelineState> state = renderPipeline(gradient, (MTLPixelFormat)550);
+        if (!target || !state) {snprintf(text, sizeof text, "Y target %d pipeline %d", target != nil, state != nil); t970Row(gpu, 46, text);}
+        else {
+            const long drawn = draw(state, target, nil);
+            float v[16];
+            const long read = computeRead(target, v);
+            snprintf(text, sizeof text, "Y render550 e%ld/%ld w%d L %d %d %d %d N %d %d %d %d R %d %d %d %d", drawn, read, (int)v[3], k(v[0]), k(v[4]),
+                     k(v[8]), k(v[12]), k(v[1]), k(v[5]), k(v[9]), k(v[13]), k(v[2]), k(v[6]), k(v[10]), k(v[14]));
+            t970Row(gpu, 46, text);
+        }
+    }
+    {
+        MTLTextureDescriptor *sd = [(id)descriptorClass texture2DDescriptorWithPixelFormat:(MTLPixelFormat)550 width:width height:height mipmapped:NO];
+        sd.usage = MTLTextureUsageShaderRead;
+        sd.storageMode = MTLStorageModeShared;
+        id<MTLTexture> source = [device newTextureWithDescriptor:sd];
+        uint32_t words[64 * 2];
+        for (NSUInteger y = 0; y < height; ++y)
+            for (NSUInteger x = 0; x < width; ++x) words[y * width + x] = (uint32_t)(384 + 8 * x) << 20 | (uint32_t)(384 + 255) << 10 | 384u;
+        if (source) [source replaceRegion:MTLRegionMake2D(0, 0, width, height) mipmapLevel:0 withBytes:words bytesPerRow:width * 4];
+        MTLTextureDescriptor *td = [(id)descriptorClass texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA32Float width:width height:height mipmapped:NO];
+        td.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+        td.storageMode = MTLStorageModeShared;
+        id<MTLTexture> target = [device newTextureWithDescriptor:td];
+        id<MTLRenderPipelineState> state = renderPipeline(sampleFs, MTLPixelFormatRGBA32Float);
+        if (!source || !target || !state) {
+            snprintf(text, sizeof text, "Z source %d target %d pipeline %d", source != nil, target != nil, state != nil);
+            t970Row(gpu, 44, text);
+        } else {
+            const long drawn = draw(state, target, source);
+            float px[64 * 4];
+            [target getBytes:px bytesPerRow:64 * 16 fromRegion:MTLRegionMake2D(0, 0, 64, 1) mipmapLevel:0];
+            snprintf(text, sizeof text, "Z fragsample550 e%ld R %d %d %d %d G %d %d A %d", drawn, k(px[4 * 4]), k(px[20 * 4]), k(px[36 * 4]),
+                     k(px[60 * 4]), k(px[4 * 4 + 1]), k(px[60 * 4 + 1]), k(px[60 * 4 + 3]));
+            t970Row(gpu, 44, text);
+        }
+    }
 }
 #include "CacheExport.h"
 #include "PrimeShaders.h"
-- 
