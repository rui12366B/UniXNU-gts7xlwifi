From d70c676a912c790713eceb7b843c6ad8d706443b Mon Sep 17 00:00:00 2001
From: t970 <morninglane27@gmail.com>
Date: Thu, 5 Nov 2026 09:59:42 +0000
Subject: [PATCH 7/7] gts7xlwifi: XR10 probe round 3 (2800x1752, 196x163, heap
 render target, fragment sampling of the big texture)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 NativeAdrenoMetalPlugin.mm | 101 +++++++++++++++++++++++++++++++++++++
 1 file changed, 101 insertions(+)

diff --git a/NativeAdrenoMetalPlugin.mm b/NativeAdrenoMetalPlugin.mm
index 52d22b7..7d28d03 100644
--- a/NativeAdrenoMetalPlugin.mm
+++ b/NativeAdrenoMetalPlugin.mm
@@ -176,6 +176,107 @@ static void t970Xr10Probe(Gpu &gpu, id<MTLDevice> device) {
                      k(px[60 * 4]), k(px[4 * 4 + 1]), k(px[60 * 4 + 1]), k(px[60 * 4 + 3]));
             t970Row(gpu, 44, text);
         }
+    }    // Round 3 (periph9): CoreAnimation's sizes and placement. read_at reads texels (x, y) of any size: L/N samples at their centres, R read().
+    id<MTLFunction> readAtFn = [library newFunctionWithName:@"xr10_read_at"], gradientW = [library newFunctionWithName:@"gradient_w"];
+    id<MTLComputePipelineState> readAt = readAtFn ? [device newComputePipelineStateWithFunction:readAtFn error:nil] : nil;
+    if (!readAt || !gradientW) {t970Row(gpu, 43, "B no round-3 functions"); return;}
+    struct At {uint32_t xs[4]; float size[2]; uint32_t y, pad;};
+    auto readTexels = [&](id<MTLTexture> texture, const At &at, float *v) -> long {
+        id<MTLBuffer> out = [device newBufferWithLength:16 * sizeof(float) options:MTLResourceStorageModeShared];
+        memset(out.contents, 0xff, 16 * sizeof(float));
+        id<MTLCommandQueue> queue = [device newCommandQueue];
+        id<MTLCommandBuffer> commands = [queue commandBuffer];
+        id<MTLComputeCommandEncoder> encoder = [commands computeCommandEncoder];
+        [encoder setComputePipelineState:readAt];
+        [encoder setTexture:texture atIndex:0];
+        [encoder setBuffer:out offset:0 atIndex:0];
+        [encoder setBytes:&at length:sizeof at atIndex:1];
+        [encoder dispatchThreads:MTLSizeMake(4, 1, 1) threadsPerThreadgroup:MTLSizeMake(4, 1, 1)];
+        [encoder endEncoding];
+        [commands commit];
+        [commands waitUntilCompleted];
+        memcpy(v, out.contents, 16 * sizeof(float));
+        return commands.error ? (long)commands.error.code : 0;
+    };
+    auto rowOf = [&](unsigned row, const char *tag, long e, const float *v) {
+        snprintf(text, sizeof text, "%s e%ld w%d h%d L %d %d %d %d N %d %d %d %d R %d %d %d %d", tag, e, (int)v[3], (int)v[7], k(v[0]), k(v[4]),
+                 k(v[8]), k(v[12]), k(v[1]), k(v[5]), k(v[9]), k(v[13]), k(v[2]), k(v[6]), k(v[10]), k(v[14]));
+        t970Row(gpu, row, text);
+    };
+    // a shared 550 texture of w x h whose red code at column x is 384 + x * 510 / w (R ~ x / w)
+    auto filled = [&](NSUInteger w, NSUInteger h) -> id<MTLTexture> {
+        MTLTextureDescriptor *d = [(id)descriptorClass texture2DDescriptorWithPixelFormat:(MTLPixelFormat)550 width:w height:h mipmapped:NO];
+        d.usage = MTLTextureUsageShaderRead;
+        d.storageMode = MTLStorageModeShared;
+        id<MTLTexture> t = [device newTextureWithDescriptor:d];
+        if (!t) return nil;
+        uint32_t *words = (uint32_t *)malloc(w * h * 4);
+        if (!words) return nil;
+        for (NSUInteger y = 0; y < h; ++y)
+            for (NSUInteger x = 0; x < w; ++x) words[y * w + x] = (uint32_t)(384 + x * 510 / w) << 20 | (uint32_t)(384 + 255) << 10 | 384u;
+        [t replaceRegion:MTLRegionMake2D(0, 0, w, h) mipmapLevel:0 withBytes:words bytesPerRow:w * 4];
+        free(words);
+        return t;
+    };
+    id<MTLTexture> big = filled(2800, 1752);
+    {   // B (row 43): 2800 x 1752, expected R ~ 36 357 714 964
+        float v[16];
+        const At at = {{100, 1000, 2000, 2700}, {2800, 1752}, 876, 0};
+        if (!big) t970Row(gpu, 43, "B big refused"); else {const long e = readTexels(big, at, v); rowOf(43, "B big2800", e, v);}
+    }
+    {   // U (row 42): 196 x 163, expected R ~ 51 306 612 969
+        id<MTLTexture> odd = filled(196, 163);
+        float v[16];
+        const At at = {{10, 60, 120, 190}, {196, 163}, 81, 0};
+        if (!odd) t970Row(gpu, 42, "U odd refused"); else {const long e = readTexels(odd, at, v); rowOf(42, "U odd196", e, v);}
+    }
+    {   // H (row 41): a private 2800 x 1752 550 render target from a private heap, gradient_w (w 2800), expected R ~ 36 357 714 964
+        MTLTextureDescriptor *d = [(id)descriptorClass texture2DDescriptorWithPixelFormat:(MTLPixelFormat)550 width:2800 height:1752 mipmapped:NO];
+        d.usage = MTLTextureUsageShaderRead | MTLTextureUsageRenderTarget;
+        d.storageMode = MTLStorageModePrivate;
+        const MTLSizeAndAlign sa = [device heapTextureSizeAndAlignWithDescriptor:d];
+        MTLHeapDescriptor *hd = [[NSClassFromString(@"MTLHeapDescriptor") alloc] init];
+        hd.size = sa.size + sa.align;
+        hd.storageMode = MTLStorageModePrivate;
+        id<MTLHeap> heap = [device newHeapWithDescriptor:hd];
+        id<MTLTexture> target = heap ? [heap newTextureWithDescriptor:d] : nil;
+        id<MTLRenderPipelineState> state = renderPipeline(gradientW, (MTLPixelFormat)550);
+        if (!target || !state) {snprintf(text, sizeof text, "H heap %d target %d pipeline %d", heap != nil, target != nil, state != nil); t970Row(gpu, 41, text);}
+        else {
+            MTLRenderPassDescriptor *pass = [passClass renderPassDescriptor];
+            pass.colorAttachments[0].texture = target;
+            pass.colorAttachments[0].loadAction = MTLLoadActionClear;
+            pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+            id<MTLCommandQueue> queue = [device newCommandQueue];
+            id<MTLCommandBuffer> commands = [queue commandBuffer];
+            id<MTLRenderCommandEncoder> encoder = [commands renderCommandEncoderWithDescriptor:pass];
+            [encoder setRenderPipelineState:state];
+            const float w = 2800.0f;
+            [encoder setFragmentBytes:&w length:sizeof w atIndex:0];
+            [encoder drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+            [encoder endEncoding];
+            [commands commit];
+            [commands waitUntilCompleted];
+            float v[16];
+            const At at = {{100, 1000, 2000, 2700}, {2800, 1752}, 876, 0};
+            const long e = readTexels(target, at, v);
+            rowOf(41, commands.error ? "H heap550 drawerr" : "H heap550", e, v);
+        }
+    }
+    {   // F (row 40): sample_fs over the big texture into a 64 x 2 RGBA32Float target, expected R ~ 70 320 570 945
+        MTLTextureDescriptor *td = [(id)descriptorClass texture2DDescriptorWithPixelFormat:MTLPixelFormatRGBA32Float width:64 height:2 mipmapped:NO];
+        td.usage = MTLTextureUsageRenderTarget | MTLTextureUsageShaderRead;
+        td.storageMode = MTLStorageModeShared;
+        id<MTLTexture> target = [device newTextureWithDescriptor:td];
+        id<MTLRenderPipelineState> state = renderPipeline(sampleFs, MTLPixelFormatRGBA32Float);
+        if (!big || !target || !state) t970Row(gpu, 40, "F refused");
+        else {
+            const long drawn = draw(state, target, big);
+            float px[64 * 4];
+            [target getBytes:px bytesPerRow:64 * 16 fromRegion:MTLRegionMake2D(0, 0, 64, 1) mipmapLevel:0];
+            snprintf(text, sizeof text, "F fragsample2800 e%ld R %d %d %d %d", drawn, k(px[4 * 4]), k(px[20 * 4]), k(px[36 * 4]), k(px[60 * 4]));
+            t970Row(gpu, 40, text);
+        }
     }
 }
 #include "CacheExport.h"
-- 
