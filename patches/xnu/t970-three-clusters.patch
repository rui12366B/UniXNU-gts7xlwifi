--- a/osfmk/kern/processor.c
+++ b/osfmk/kern/processor.c
@@ -367,6 +367,13 @@
 cluster_type_t
 pset_type_for_id(uint32_t cluster_id)
 {
+#if defined(ARM64_BOARD_CONFIG_BCM2837)
+	/* gts7xlwifi, as SM-T733: the topology exists before ArmCpu registers the secondary psets. */
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	if (cluster_id < topology->num_clusters) {
+		return topology->clusters[cluster_id].cluster_type;
+	}
+#endif
 	return pset_array[cluster_id]->pset_type;
 }
 
