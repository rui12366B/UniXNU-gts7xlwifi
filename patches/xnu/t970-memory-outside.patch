+
+/* Add [base, end) to the table of runs, less the reserved ranges from `from` on. */
+static void
+arm_vm_outside_add(uint64_t base, uint64_t end, const uint8_t *reserved, unsigned int reserved_size, unsigned int from)
+{
+	uint64_t r_base, r_end;
+
+	for (unsigned int i = from; arm_vm_outside_pair(reserved, reserved_size, i, &r_base, &r_end); i++) {
+		if (r_end <= r_base || r_end <= base || r_base >= end) {
+			continue;
+		}
+		if (base < r_base) {
+			arm_vm_outside_add(base, r_base, reserved, reserved_size, i + 1);
+		}
+		if (end > r_end) {
+			arm_vm_outside_add(r_end, end, reserved, reserved_size, i + 1);
+		}
+		return;
+	}
+	/* Whole pages only; a page partly outside the run is not the kernel's. */
+	base = (base + PAGE_MASK) & ~((uint64_t)PAGE_MASK);
+	end &= ~((uint64_t)PAGE_MASK);
+	if (base >= end || arm_vm_outside_count >= ARM_VM_OUTSIDE_RANGES) {
+		return;
+	}
+	arm_vm_outside_table[arm_vm_outside_count].base = base;
+	arm_vm_outside_table[arm_vm_outside_count].end = end;
+	arm_vm_outside_count++;
