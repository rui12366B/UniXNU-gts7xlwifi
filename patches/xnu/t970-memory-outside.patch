+/* One (base, size) pair of a device tree property; false past its end. */
+static bool
+arm_vm_outside_pair(const uint8_t *pairs, unsigned int pairs_size, unsigned int index, uint64_t *base, uint64_t *end)
+{
+	const unsigned int offset = index * 2 * sizeof(uint64_t);
+	uint64_t size;
+
+	if (pairs == NULL || offset + 2 * sizeof(uint64_t) > pairs_size) {
+		return false;
+	}
+	memcpy(base, pairs + offset, sizeof(*base));
+	memcpy(&size, pairs + offset + sizeof(*base), sizeof(size));
+	*end = *base + size;
+	return true;
