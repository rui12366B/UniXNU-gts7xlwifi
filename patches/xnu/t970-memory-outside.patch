+/*
+ * gts7xlwifi (port of UniXNU 8f5a4e9): make one page of the memory outside the managed span a kernel-managed page:
+ * map it in the physical aperture, as the span's own pages are (kernel read-write, never executable), then mark it.
+ * The caller owns the page: nothing maps it, and it is not handed to the VM before this returns. Not for pages the
+ * firmware keeps.
+ */
+kern_return_t
+pmap_adopt_outside_page(ppnum_t pn)
+{
+	const pmap_paddr_t pa = ptoa(pn);
+
+	if ((pa < vm_outside_first_phys) || (pa >= vm_outside_last_phys)) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	const unsigned int page = (unsigned int)atop(pa - vm_outside_first_phys);
+	const uint64_t bit = 1ULL << (page % 64);
+	if (os_atomic_load(&vm_outside_valid[page / 64], relaxed) & bit) {
+		return KERN_ALREADY_IN_SET;
+	}
+
+	const vm_map_address_t va = phystokv(pa);
+	const pt_attr_t * const pt_attr = pmap_get_pt_attr(kernel_pmap);
+	pt_entry_t *ptep;
+
+	while ((ptep = pmap_pte(kernel_pmap, va)) == PT_ENTRY_NULL) {
+		const kern_return_t kr = pmap_expand(kernel_pmap, va, 0, pt_attr_leaf_level(pt_attr));
+		if (kr != KERN_SUCCESS) {
+			return kr;
+		}
+	}
+	if (__improbable(*ptep != ARM_PTE_EMPTY)) {
+		panic("%s: aperture address %p of page 0x%x is mapped: 0x%llx", __func__, (void *)va, pn, (unsigned long long)*ptep);
+	}
+	pt_entry_t pte = pa_to_pte(pa) | ARM_PTE_TYPE_VALID | ARM_PTE_AF | ARM_PTE_SH(SH_OUTER_MEMORY) |
+	    ARM_PTE_ATTRINDX(CACHE_ATTRINDX_DEFAULT) | ARM_PTE_AP(AP_RWNA) | ARM_PTE_NX | ARM_PTE_PNX;
+#if __ARM_KERNEL_PROTECT__
+	pte |= ARM_PTE_NG;
+#endif /* __ARM_KERNEL_PROTECT__ */
